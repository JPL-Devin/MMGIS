@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title MMGIS - Getting Started View

top to bottom direction
LAYOUT_WITH_LEGEND()

skinparam {
    BackgroundColor white
    Shadowing true
    RoundCorner 15
    DefaultFontName "Segoe UI"
    DefaultFontSize 12
    ArrowColor #555555
    ArrowThickness 1.5
    wrapWidth 200
}

AddElementTag("prereq", $bgColor="#37474F", $fontColor="white", $borderColor="#263238")
AddElementTag("step", $bgColor="#1565C0", $fontColor="white", $borderColor="#0D47A1")
AddElementTag("service", $bgColor="#00695C", $fontColor="white", $borderColor="#004D40")
AddElementTag("optional", $bgColor="#6A1B9A", $fontColor="white", $borderColor="#4A148C")
AddElementTag("env", $bgColor="#E65100", $fontColor="white", $borderColor="#BF360C")
AddElementTag("launch", $bgColor="#2E7D32", $fontColor="white", $borderColor="#1B5E20")

Person(operator, "New Operator", "Setting up MMGIS\nfor the first time")

System_Boundary(prereqs, "Prerequisites") {
    Component(nodejs, "Node.js 22+", "Runtime", "Required for bare-metal", $tags="prereq")
    Component(postgresql, "PostgreSQL 16+\nwith PostGIS", "Database", "Required for all deployments", $tags="prereq")
    Component(docker_engine, "Docker + Compose", "Containers", "Recommended method", $tags="prereq")
    Component(python_env, "Python 3 + GDAL", "Optional", "Elevation & spatial processing", $tags="prereq")
}

System_Boundary(docker_deploy, "Option A: Docker Deployment (Recommended)") {
    Component(d_clone, "1. Clone Repo", "git clone", "github.com/NASA-AMMOS/MMGIS", $tags="step")
    Component(d_env, "2. Configure .env", "cp sample.env .env", "Set DB_NAME, DB_USER,\nDB_PASS, SECRET (24+ chars)", $tags="step")
    Component(d_compose, "3. Setup Compose", "cp docker-compose.sample.yml\ndocker-compose.yml", "Set POSTGRES_PASSWORD", $tags="step")
    Component(d_up, "4. Launch", "docker-compose up -d", "Starts all services", $tags="step")
}

System_Boundary(docker_services, "Docker Services") {
    Component(svc_mmgis, "MMGIS", ":8888", "Main app server", $tags="service")
    Component(svc_db, "PostGIS DB", ":5432", "Persistent volume", $tags="service")
    Component(svc_stac, "STAC FastAPI", ":8881", "Asset catalog", $tags="optional")
    Component(svc_titiler, "TiTiler", ":8883", "COG tile rendering", $tags="optional")
    Component(svc_tipg, "TiPG", ":8882", "Vector tiles", $tags="optional")
    Component(svc_velo, "Veloserver", ":8104", "Velocity data", $tags="optional")
}

System_Boundary(bare_metal, "Option B: Local / Bare-Metal Development") {
    Component(b_install, "1. npm install", "Dependencies", "Main app dependencies", $tags="step")
    Component(b_db, "2. Setup PostgreSQL", "Install + PostGIS", "Create database", $tags="step")
    Component(b_env, "3. Configure .env", "cp sample.env .env", "DB_HOST=localhost, etc.", $tags="step")
    Component(b_build, "4. npm run build", "Webpack 5", "Production bundle", $tags="step")
    Component(b_configure, "5. Build Configure", "cd configure &&\nnpm install && npm run build", "Admin CMS page", $tags="step")
    Component(b_start, "6. npm start", "Launch", "Dev: hot-reload on :8889", $tags="step")
}

System_Boundary(env_config, "Key Environment Variables") {
    Component(env_req, "Required", ".env", "DB_NAME, DB_USER, DB_PASS\nSECRET (min 24 chars)\nPORT (default 8888)", $tags="env")
    Component(env_auth, "Authentication", ".env", "AUTH: off | none | local | csso\nAUTH_LOCAL_ALLOW_SIGNUP", $tags="env")
    Component(env_adj, "Adjacent Servers", ".env", "WITH_STAC, WITH_TITILER\nWITH_TIPG, WITH_VELOSERVER", $tags="env")
    Component(env_opt, "Optional", ".env", "ROOT_PATH, MAIN_MISSION\nWEBSOCKETS, HIDE_CONFIG", $tags="env")
}

System_Boundary(first_launch, "First-Time UI Setup") {
    Component(fl_config, "1. Open /configure", "Browser", "Navigate to {domain}/configure", $tags="launch")
    Component(fl_admin, "2. Create Admin", "First Signup", "First user = SuperAdmin (111)", $tags="launch")
    Component(fl_mission, "3. New Mission", "Create", "Name & create first mission", $tags="launch")
    Component(fl_app, "4. Open App", "Browse", "Navigate to {domain}/", $tags="launch")
}

Rel_D(operator, d_clone, "Docker path")
Rel_R(d_clone, d_env, "then")
Rel_R(d_env, d_compose, "then")
Rel_R(d_compose, d_up, "then")
Rel_D(d_up, svc_mmgis, "Creates")
Rel(svc_mmgis, svc_db, "Connects")

Rel_D(operator, b_install, "Or: bare-metal path")
Rel_R(b_install, b_db, "then")
Rel_R(b_db, b_env, "then")

Rel_D(operator, fl_config, "After server running")
Rel_R(fl_config, fl_admin, "then")
Rel_R(fl_admin, fl_mission, "then")
Rel_R(fl_mission, fl_app, "then")

@enduml
