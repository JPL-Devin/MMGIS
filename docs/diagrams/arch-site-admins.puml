@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title MMGIS - Site Administrator View

top to bottom direction
LAYOUT_WITH_LEGEND()

skinparam {
    BackgroundColor white
    Shadowing true
    RoundCorner 15
    DefaultFontName "Segoe UI"
    DefaultFontSize 12
    ArrowColor #555555
    ArrowThickness 1.5
    wrapWidth 200
}

AddElementTag("cms", $bgColor="#1565C0", $fontColor="white", $borderColor="#0D47A1")
AddElementTag("auth", $bgColor="#C62828", $fontColor="white", $borderColor="#B71C1C")
AddElementTag("ops", $bgColor="#00695C", $fontColor="white", $borderColor="#004D40")
AddElementTag("env", $bgColor="#E65100", $fontColor="white", $borderColor="#BF360C")
AddElementTag("monitor", $bgColor="#6A1B9A", $fontColor="white", $borderColor="#4A148C")
AddElementTag("data", $bgColor="#37474F", $fontColor="white", $borderColor="#263238")

Person(superadmin, "SuperAdmin", "Full system access (perm 111)")
Person(admin, "Mission Admin", "Manages assigned missions (perm 110)")

System_Boundary(admin_interfaces, "Administration Interfaces") {

    Container_Boundary(configure_cms, "Configure Page (/configure)") {
        Component(mission_mgmt, "Mission Management", "CRUD", "Create, rename, duplicate,\ndelete missions", $tags="cms")
        Component(layer_editor, "Layer Editor", "Config", "Add/edit/remove layers,\ntypes, styling, sources", $tags="cms")
        Component(tool_config, "Tool Configuration", "Settings", "Enable/disable tools,\ntool-specific options", $tags="cms")
        Component(panel_config, "Panel & Projection", "Layout", "Panel arrangement, projection,\nbounds, zoom, body", $tags="cms")
    }

    Container_Boundary(user_admin, "User & Access Management") {
        Component(user_roles, "Role Management", "Permissions", "SuperAdmin (111)\nAdmin (110) / User (001)", $tags="auth")
        Component(user_accounts, "Account Management", "CRUD", "Create, view, update,\ndeactivate accounts", $tags="auth")
        Component(mission_access, "Mission Access", "Per-mission", "Assign users to missions", $tags="auth")
        Component(group_config, "Group Management", "CSSO_GROUPS", "LDAP group-to-role mapping", $tags="auth")
    }

    Container_Boundary(token_webhook, "Tokens & Webhooks") {
        Component(ltt_manage, "API Tokens", "Long-Term", "Generate, view, revoke\nBearer tokens", $tags="ops")
        Component(webhook_config, "Webhooks", "CRUD", "External system notifications", $tags="ops")
    }

    Container_Boundary(geodata_admin, "Geodataset Administration") {
        Component(geodataset_upload, "Upload", "PostGIS Import", "GeoJSON / Shapefile import", $tags="data")
        Component(geodataset_manage, "Manage", "CRUD", "View, update, delete", $tags="data")
    }
}

System_Boundary(auth_modes, "Authentication Modes (AUTH env)") {
    Component(auth_off, "off", "Open Access", "No login, guests only", $tags="auth")
    Component(auth_none, "none", "Optional Login", "Open + optional registration", $tags="auth")
    Component(auth_local, "local", "Required Login", "Admin creates accounts\nor self-signup", $tags="auth")
    Component(auth_csso, "csso", "SSO", "Reverse proxy headers\nX-Sub, X-Groups", $tags="auth")
}

System_Boundary(env_controls, "Operational Controls") {
    Component(security_envs, "Security", "ENVs", "HIDE_CONFIG, HTTPS,\nFRAME_ANCESTORS, CSP", $tags="env")
    Component(deployment_envs, "Deployment", "ENVs", "ROOT_PATH, MAIN_MISSION,\nFORCE_CONFIG_PATH", $tags="env")
    Component(collab_envs, "Collaboration", "ENVs", "ENABLE_MMGIS_WEBSOCKETS\nENABLE_CONFIG_OVERRIDE", $tags="env")
    Component(adjacent_envs, "Adjacent Servers", "ENVs", "WITH_STAC, WITH_TITILER\nWITH_TIPG, WITH_VELOSERVER", $tags="env")
}

System_Boundary(monitoring, "Monitoring & Data") {
    Component(healthcheck, "Health Check", "/api/utils/healthcheck", "Load balancer endpoint", $tags="monitor")
    Component(logging, "Winston Logger", "Structured", "info, warn, error,\ninfrastructure_error", $tags="monitor")
    Component(missions_dir, "Missions Dir", "File Storage", "Configs, tiles, uploads", $tags="data")
    Component(spice_kernels, "SPICE Kernels", "Scheduled", "Auto-download on cron", $tags="data")
}

ContainerDb(postgres, "PostgreSQL / PostGIS", "Database", "Users, sessions, configs,\ngeodata, tokens, webhooks")

Rel_D(superadmin, configure_cms, "Manages all missions")
Rel_D(superadmin, user_admin, "Manages users & roles")
Rel_D(superadmin, token_webhook, "Manages tokens & webhooks")
Rel_D(superadmin, geodata_admin, "Manages geodatasets")

Rel(admin, mission_mgmt, "Manages assigned missions")
Rel(admin, layer_editor, "Configures layers")

Rel(superadmin, auth_modes, "Selects via AUTH env")
Rel(superadmin, env_controls, "Configures via .env")

Rel(configure_cms, postgres, "Reads/writes config")
Rel(user_admin, postgres, "Reads/writes users")
Rel(geodata_admin, postgres, "Reads/writes geodata")

@enduml
