@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title MMGIS - API Consumer View

top to bottom direction
LAYOUT_WITH_LEGEND()

skinparam {
    BackgroundColor white
    Shadowing true
    RoundCorner 15
    DefaultFontName "Segoe UI"
    DefaultFontSize 12
    ArrowColor #555555
    ArrowThickness 1.5
    wrapWidth 200
}

AddElementTag("auth", $bgColor="#C62828", $fontColor="white", $borderColor="#B71C1C")
AddElementTag("endpoint", $bgColor="#1565C0", $fontColor="white", $borderColor="#0D47A1")
AddElementTag("sdk", $bgColor="#00695C", $fontColor="white", $borderColor="#004D40")
AddElementTag("ws", $bgColor="#E65100", $fontColor="white", $borderColor="#BF360C")
AddElementTag("docs", $bgColor="#6A1B9A", $fontColor="white", $borderColor="#4A148C")
AddElementTag("server", $bgColor="#37474F", $fontColor="white", $borderColor="#263238")

Person(api_dev, "API Consumer", "Developers integrating\nwith MMGIS programmatically")
Person(embed_dev, "Embed Developer", "Developers embedding\nMMGIS in web apps")

System_Boundary(mmgis_api, "MMGIS API Surface") {

    Container_Boundary(auth_api, "Authentication Mechanisms") {
        Component(auth_local, "Local Auth", "POST /api/users/signup\nPOST /api/users/login", "Username/password\nFirst signup = admin", $tags="auth")
        Component(auth_token, "Long-Term Tokens", "Authorization: Bearer {token}", "Configurable expiration\ngenerate / list / delete", $tags="auth")
        Component(auth_csso, "CSSO (SSO)", "X-Sub, X-Groups headers", "Reverse proxy header-based", $tags="auth")
        Component(auth_session, "Session Cookie", "MMGISSession", "Permissions: 111 / 110 / 001", $tags="auth")
    }

    Container_Boundary(rest_api, "REST API Endpoints") {
        Component(config_ep, "Configuration", "/api/configure/*", "Mission CRUD (admin only)\nget, missions, add, save, remove", $tags="endpoint")
        Component(draw_ep, "Draw", "/api/draw/*", "Feature CRUD, publish,\nmerge, undo", $tags="endpoint")
        Component(geo_ep, "Geodatasets", "/api/geodatasets/*", "PostGIS spatial queries\nbbox, intersect, within", $tags="endpoint")
        Component(files_ep, "Files", "/api/files/*", "Mission file serving\n& upload", $tags="endpoint")
        Component(users_ep, "Users", "/api/users/*", "Account management\n& role assignment", $tags="endpoint")
        Component(webhooks_ep, "Webhooks", "/api/webhooks/*", "External event notifications", $tags="endpoint")
        Component(tokens_ep, "Tokens", "/api/longtermtokens/*", "Bearer token management", $tags="endpoint")
        Component(utils_ep, "Utilities", "/api/utils/*", "Health check, URL shortening", $tags="endpoint")
    }

    Container_Boundary(ws_api, "WebSocket API") {
        Component(ws_conn, "Connection", "ws(s)://{host}{ROOT_PATH}/", "Upgrade HTTP to WebSocket", $tags="ws")
        Component(ws_events, "Events", "JSON Messages", "addLayer, updateLayer, removeLayer,\nconfig changes, draw sync", $tags="ws")
    }

    Container_Boundary(client_sdk, "Client-Side SDK (mmgisAPI)") {
        Component(sdk_layers, "mmgisAPI.layers.*", "Layer Control", "Add, remove, toggle, get data", $tags="sdk")
        Component(sdk_map, "mmgisAPI.map.*", "Map Control", "Set view, zoom, bounds", $tags="sdk")
        Component(sdk_tools, "mmgisAPI.tools.*", "Tool Control", "Open/close, get state", $tags="sdk")
        Component(sdk_events, "mmgisAPI.on(event)", "Events", "Map clicks, layer changes, WS", $tags="sdk")
    }

    Container_Boundary(api_docs, "Documentation") {
        Component(swagger, "Swagger UI", "GET /api/docs", "Interactive OpenAPI 3.0 docs", $tags="docs")
    }
}

Container(mmgis_server, "MMGIS Server", "Express 5", "Rate limit: 20K req/5min\nJSON body: 500MB max\ngzip compression", $tags="server")

Rel_D(api_dev, auth_local, "Authenticates")
Rel_D(api_dev, auth_token, "Uses Bearer token")
Rel(auth_local, auth_session, "Sets session cookie")

Rel(api_dev, config_ep, "Reads config")
Rel(api_dev, geo_ep, "Queries geodata")
Rel(api_dev, draw_ep, "Manages features")
Rel(api_dev, ws_conn, "Subscribes to events")
Rel(api_dev, swagger, "Explores API")

Rel(embed_dev, sdk_layers, "Controls layers")
Rel(embed_dev, sdk_map, "Controls map")
Rel(embed_dev, sdk_events, "Subscribes")

Rel(ws_conn, ws_events, "Sends/receives")
Rel(rest_api, mmgis_server, "Served by")

@enduml
