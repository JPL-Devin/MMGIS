@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title MMGIS - UI User View

top to bottom direction
LAYOUT_WITH_LEGEND()

skinparam {
    BackgroundColor white
    Shadowing true
    RoundCorner 15
    DefaultFontName "Segoe UI"
    DefaultFontSize 12
    ArrowColor #555555
    ArrowThickness 1.5
    wrapWidth 200
}

AddElementTag("nav", $bgColor="#1565C0", $fontColor="white", $borderColor="#0D47A1")
AddElementTag("map", $bgColor="#0277BD", $fontColor="white", $borderColor="#01579B")
AddElementTag("tool", $bgColor="#00695C", $fontColor="white", $borderColor="#004D40")
AddElementTag("data", $bgColor="#4527A0", $fontColor="white", $borderColor="#311B92")
AddElementTag("collab", $bgColor="#C62828", $fontColor="white", $borderColor="#B71C1C")
AddElementTag("external", $bgColor="#37474F", $fontColor="white", $borderColor="#263238")

Person(user, "Mission User", "Scientists, engineers, analysts\nviewing geospatial data")
Person(admin, "Site Administrator", "Configures missions,\nmanages users & layers")

System_Boundary(mmgis_ui, "MMGIS Web Application") {

    Container_Boundary(entry, "Entry & Navigation") {
        Component(login, "Login Page", "Authentication", "Sign up / sign in\n(mode-dependent)", $tags="nav")
        Component(landing, "Landing Page", "Mission Selector", "Browse and select\navailable missions", $tags="nav")
    }

    Container_Boundary(map_views, "Map Visualization Panels") {
        Component(map2d, "2D Map", "Leaflet", "Pan, zoom, click, toggle layers,\nmeasure, draw", $tags="map")
        Component(globe3d, "3D Globe", "Cesium / LithoSphere", "Rotate, tilt, terrain,\n3D model visualization", $tags="map")
        Component(viewer_panel, "Viewer Panel", "Multi-format", "High-res imagery, photospheres,\n3D models, PDFs, videos", $tags="map")
    }

    Container_Boundary(science_tools, "Science & Analysis Tools") {
        Component(measure_tool, "Measure", "Analysis", "Distance, elevation profiles,\nline-of-sight", $tags="tool")
        Component(identify_tool, "Identifier", "Query", "Click to query pixel values", $tags="tool")
        Component(chemistry_tool, "Chemistry", "Science", "Chemical composition data", $tags="tool")
        Component(curtain_tool, "Curtain", "Subsurface", "Radar imagery display", $tags="tool")
        Component(isochrone_tool, "Isochrone", "Traversability", "Terrain reachability mapping", $tags="tool")
        Component(shade_tool, "Shade", "Illumination", "Shadow visualization (SPICE)", $tags="tool")
        Component(viewshed_tool, "Viewshed", "Visibility", "Line-of-sight analysis", $tags="tool")
        Component(query_tool, "Query", "Search", "Spatial & attribute queries", $tags="tool")
    }

    Container_Boundary(creation_tools, "Creation & Management Tools") {
        Component(draw_tool, "Draw", "Collaborative", "Points, lines, polygons\nwith real-time sync", $tags="tool")
        Component(layers_tool, "Layers", "Management", "Toggle, reorder, opacity", $tags="tool")
        Component(legend_tool, "Legend", "Reference", "Auto-generated from styling", $tags="tool")
        Component(animation_tool, "Animation", "Export", "GIFs/MP4s from map", $tags="tool")
        Component(sites_tool, "Sites", "Navigation", "Bookmarks & viewpoints", $tags="tool")
        Component(time_tool, "Time Control", "Temporal", "Filter by time, animate", $tags="tool")
        Component(info_tool, "Info", "Details", "Feature properties panel", $tags="tool")
        Component(kinds_tool, "Kinds", "Behavior", "Layer-specific actions", $tags="tool")
    }

    Container_Boundary(data_types, "Data & Layer Types") {
        Component(vector_layers, "Vector", "GeoJSON/Shapefile", "Points, lines, polygons", $tags="data")
        Component(tile_layers, "Tile", "XYZ/WMTS", "Base maps, imagery, terrain", $tags="data")
        Component(cog_layers, "COG", "TiTiler", "Cloud-Optimized GeoTIFF", $tags="data")
        Component(model_layers, "3D Model", "OBJ/GLTF", "Models on surfaces", $tags="data")
        Component(stac_layers, "STAC", "Catalog", "Discover & mosaic assets", $tags="data")
    }

    Container_Boundary(collab, "Collaboration & Sharing") {
        Component(realtime, "Real-time Sync", "WebSocket", "Live edits & notifications", $tags="collab")
        Component(deeplinks, "Deep Links", "URL Sharing", "Share exact map state", $tags="collab")
        Component(exports, "Data Export", "Download", "GeoJSON, Shapefile, KML", $tags="collab")
    }
}

Container(app_server, "MMGIS Server", "Node.js / Express", "API, data, auth", $tags="external")
Container(configure_page, "Configure Page", "Admin CMS", "Mission & layer setup", $tags="external")
System_Ext(planetary_data, "Planetary Data Sources", "NASA PDS, STAC catalogs,\nremote tile servers")

Rel_D(user, login, "Authenticates")
Rel_D(user, landing, "Selects mission")
Rel(landing, map2d, "Opens mission")

Rel(user, map2d, "Pans, zooms, clicks")
Rel(user, globe3d, "Explores 3D")
Rel(user, draw_tool, "Creates features")
Rel(user, measure_tool, "Measures")
Rel(user, deeplinks, "Shares state")

Rel(map2d, vector_layers, "Renders")
Rel(map2d, tile_layers, "Renders")
Rel(map2d, cog_layers, "Renders via TiTiler")
Rel(globe3d, model_layers, "Renders")
Rel(realtime, draw_tool, "Syncs edits")

Rel(admin, configure_page, "Manages missions")
Rel(map_views, app_server, "Requests data")
Rel_D(app_server, planetary_data, "Fetches remote data")

@enduml
