@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title MMGIS - Infrastructure & Deployment View

top to bottom direction
LAYOUT_WITH_LEGEND()

skinparam {
    BackgroundColor white
    Shadowing true
    RoundCorner 15
    DefaultFontName "Segoe UI"
    DefaultFontSize 12
    ArrowColor #555555
    ArrowThickness 1.5
    wrapWidth 200
}

AddElementTag("core", $bgColor="#1565C0", $fontColor="white", $borderColor="#0D47A1")
AddElementTag("db", $bgColor="#C62828", $fontColor="white", $borderColor="#B71C1C")
AddElementTag("adjacent", $bgColor="#00695C", $fontColor="white", $borderColor="#004D40")
AddElementTag("ci", $bgColor="#2E7D32", $fontColor="white", $borderColor="#1B5E20")
AddElementTag("security", $bgColor="#E65100", $fontColor="white", $borderColor="#BF360C")
AddElementTag("network", $bgColor="#4527A0", $fontColor="white", $borderColor="#311B92")
AddElementTag("storage", $bgColor="#6A1B9A", $fontColor="white", $borderColor="#4A148C")
AddElementTag("proxy", $bgColor="#37474F", $fontColor="white", $borderColor="#263238")
AddRelTag("dashed", $lineStyle=DashedLine())

Person(devops, "DevOps / Platform Engineer", "Manages deployment,\nscaling, monitoring")

System_Boundary(docker_stack, "Docker Compose Stack") {

    Container_Boundary(mmgis_svc, "MMGIS Application Service") {
        Component(mmgis_app, "MMGIS Container", "Node.js 22 / Express 5", "Port: 8888\nghcr.io/nasa-ammos/mmgis\nMulti-stage (OracleLinux 8.9)\nHealth: /api/utils/healthcheck", $tags="core")
        Component(mmgis_python, "Python Env", "Micromamba / GDAL", "Elevation profiles &\nspatial processing", $tags="core")
    }

    Container_Boundary(db_svc, "Database Service") {
        Component(postgis, "PostgreSQL + PostGIS", "postgis/postgis:18-3.6-alpine", "Port: 5432 (internal)\nVolume: mmgis-db\nshm_size: 1g\nHealth: pg_isready", $tags="db")
        Component(db_config, "Pool Config", "Settings", "DB_POOL_MAX (def 10)\nDB_POOL_TIMEOUT (30s)\nOptional SSL", $tags="db")
    }

    Container_Boundary(adj_svcs, "Adjacent Services (Optional)") {
        Component(stac, "STAC FastAPI", ":8881", "Asset catalog, transactions", $tags="adjacent")
        Component(titiler, "TiTiler", ":8883", "Dynamic COG tiles\nMem limit: 8G", $tags="adjacent")
        Component(titiler_pg, "TiTiler-pgSTAC", ":8884", "STAC mosaic tiles\nMem: 12G (reserve 8G)", $tags="adjacent")
        Component(tipg, "TiPG", ":8882", "OGC vector tiles\nWEB_CONCURRENCY: 10", $tags="adjacent")
        Component(veloserver, "Veloserver", ":8104", "Wind/velocity viz", $tags="adjacent")
    }
}

System_Boundary(proxy_arch, "Proxy Architecture") {
    Component(adj_proxy, "Internal Proxy", "http-proxy-middleware", "/titiler/* -> :8883\n/stac/* -> :8881\n/tipg/* -> :8882\n/veloserver/* -> :8104", $tags="proxy")
    Component(custom_proxy, "Custom Servers", "ADJACENT_SERVER_CUSTOM_*", "User-defined proxy routes", $tags="proxy")
    Component(ext_proxy, "External Reverse Proxy", "nginx / Apache (optional)", "HTTPS termination, CSP,\nCSS/SSO integration", $tags="proxy")
}

System_Boundary(security, "Security Configuration") {
    Component(helmet, "Helmet.js", "HTTP Headers", "CSP, X-Frame-Options,\ncross-origin policies", $tags="security")
    Component(rate_limit, "Rate Limiter", "express-rate-limit", "20K requests / 5 min\non /api/* routes", $tags="security")
    Component(ssl_config, "HTTPS", "Built-in / Proxy", "HTTPS=true with certs\nor external termination", $tags="security")
    Component(titiler_ssrf, "URL Validation", "SSRF Prevention", "TITILER_ALLOWED_URL_PATTERNS", $tags="security")
}

System_Boundary(ci_cd, "CI/CD Pipeline (GitHub Actions)") {
    Component(test_ci, "playwright-tests.yml", "Testing", "E2E + unit tests\nMatrix: auth modes", $tags="ci")
    Component(docker_ci, "docker-build.yml", "Build", "Multi-arch Docker\n(amd64 + arm64)", $tags="ci")
    Component(secrets_ci, "secrets-detection.yaml", "Security", "Blocks secret commits", $tags="ci")
    Component(version_ci, "bump-version.yml", "Release", "Auto version bump", $tags="ci")
}

System_Boundary(networking, "Networking & Ports") {
    Component(port_map, "Port Map", "Reference", "8888 MMGIS (main)\n8889 Dev (PORT+1)\n8881 STAC | 8882 TiPG\n8883 TiTiler | 8884 pgSTAC\n8104 Veloserver | 5432 PG", $tags="network")
    Component(ws_config, "WebSocket", "ws/wss", "ENABLE_MMGIS_WEBSOCKETS\nWEBSOCKET_ROOT_PATH", $tags="network")
    Component(subpath, "Subpath Deploy", "ROOT_PATH", "ROOT_PATH=/maps/mmgis\nEXTERNAL_ROOT_PATH", $tags="network")
}

System_Boundary(storage, "Storage & Persistence") {
    Component(db_vol, "DB Volume", "Docker Volume", "mmgis-db: persistent data", $tags="storage")
    Component(missions_vol, "Missions", "Bind Mount", "Configs, tiles, uploads", $tags="storage")
    Component(ssl_vol, "SSL", "Bind Mount", "HTTPS certificates", $tags="storage")
    Component(spice_store, "SPICE Kernels", "Scheduled", "Auto-download on cron", $tags="storage")
}

Rel_D(devops, docker_stack, "Deploys & manages")
Rel_D(devops, ci_cd, "Monitors pipeline")
Rel(devops, security, "Configures")

Rel(mmgis_app, postgis, "TCP :5432 Sequelize")
Rel(mmgis_app, adj_proxy, "Proxies requests")
Rel(adj_proxy, stac, "HTTP :8881", $tags="dashed")
Rel(adj_proxy, titiler, "HTTP :8883", $tags="dashed")
Rel(adj_proxy, tipg, "HTTP :8882", $tags="dashed")

Rel(stac, postgis, "SQL (mmgis-stac)")
Rel(titiler_pg, postgis, "SQL (mmgis-stac)")

Rel(ext_proxy, mmgis_app, "HTTPS -> HTTP :8888")

Rel(mmgis_app, missions_vol, "Reads/writes")
Rel(postgis, db_vol, "Persists data")

Rel(docker_ci, mmgis_app, "Builds image")
Rel(test_ci, mmgis_app, "Tests against")

@enduml
