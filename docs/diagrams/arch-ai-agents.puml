@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title MMGIS - AI Agent Operating Manual

top to bottom direction
LAYOUT_WITH_LEGEND()

skinparam {
    BackgroundColor white
    Shadowing true
    RoundCorner 15
    DefaultFontName "Segoe UI"
    DefaultFontSize 12
    ArrowColor #555555
    ArrowThickness 1.5
    wrapWidth 200
}

AddElementTag("context", $bgColor="#1565C0", $fontColor="white", $borderColor="#0D47A1")
AddElementTag("rule", $bgColor="#C62828", $fontColor="white", $borderColor="#B71C1C")
AddElementTag("workflow", $bgColor="#00695C", $fontColor="white", $borderColor="#004D40")
AddElementTag("api", $bgColor="#4527A0", $fontColor="white", $borderColor="#311B92")
AddElementTag("extension", $bgColor="#6A1B9A", $fontColor="white", $borderColor="#4A148C")
AddElementTag("test", $bgColor="#2E7D32", $fontColor="white", $borderColor="#1B5E20")
AddElementTag("cmd", $bgColor="#E65100", $fontColor="white", $borderColor="#BF360C")

Person(agent, "AI Coding Agent", "Claude, Cursor, Devin,\nCopilot, or similar")

System_Boundary(context_files, "AI Context Files (Read First)") {
    Component(agents_md, "AGENTS.md", "Primary Context", "Project overview, quick start,\ncritical rules, architecture", $tags="context")
    Component(claude_md, "CLAUDE.md", "Redirect", "Points to AGENTS.md", $tags="context")
    Component(knowledge_dir, ".knowledge/", "Deep Context", "AI-GETTING-STARTED.md\nAI-DEVELOPMENT.md\ncode-patterns.md\nconventions-and-gotchas.md", $tags="context")
    Component(specify_dir, ".specify/", "Spec-Kit", "constitution.md (7 principles)\nscripts/ & templates/", $tags="context")
}

System_Boundary(critical_rules, "Critical Rules (Must Not Break)") {
    Component(rule_hotreload, "Hot-Reload in Dev", "Do NOT npm run build", "webpack-dev-server on PORT+1", $tags="rule")
    Component(rule_configure, "Configure = Separate Build", "cd configure &&\nnpm install && npm run build", "Independent React app", $tags="rule")
    Component(rule_postgis, "PostGIS Required", "init-db.js creates extensions", "Must be installed", $tags="rule")
    Component(rule_env, "ENV Triple-Update", "Always update all 3", ".env + sample.env + ENVs.md", $tags="rule")
    Component(rule_sql, "No Raw SQL for Data", "Use APIs & UI only", "Never bypass app layer", $tags="rule")
    Component(rule_admin, "Admin Auth Always", "Even AUTH=off", "CMS requires admin session", $tags="rule")
    Component(rule_db, "Database Safety", "Never DROP DATABASE", "Test DBs: mmgis-test only", $tags="rule")
}

System_Boundary(dev_workflow, "Development Workflow") {
    Component(speckit, "Spec-Kit Process", "5-Step", "1. specify  2. plan  3. tasks\n4. implement  5. checklist", $tags="workflow")
    Component(constitution, "Constitution", "7 Principles", "Docs-First, Clear Requirements,\nIncremental, Quality Standards,\nNode.js Best Practices,\nGeospatial, Collaboration Safety", $tags="workflow")
    Component(ref_mission, "Reference Mission", "Blueprint", "blueprints/Missions/\nReference-Mission", $tags="workflow")
}

System_Boundary(api_routes, "API Route Groups") {
    Component(api_configure, "/api/configure/*", "Admin", "Mission CRUD", $tags="api")
    Component(api_users, "/api/users/*", "Auth", "signup, login, logout", $tags="api")
    Component(api_draw, "/api/draw/*", "Features", "CRUD, publish, merge", $tags="api")
    Component(api_geodatasets, "/api/geodatasets/*", "Spatial", "get, search, upload", $tags="api")
    Component(api_files, "/api/files/*", "Files", "getfile, upload", $tags="api")
    Component(api_tokens, "/api/longtermtokens/*", "Auth", "Token management", $tags="api")
}

System_Boundary(extensions, "Extension Points") {
    Component(tool_plugin, "Tool Plugins", "src/essence/*Plugin-Tools*/", "Custom tool: make()/destroy()", $tags="extension")
    Component(backend_plugin, "Backend Plugins", "API/*Plugin-Backend*/", "Custom Express routes", $tags="extension")
    Component(comp_plugin, "Component Plugins", "src/essence/*Plugin-Components*/", "Custom UI behaviors", $tags="extension")
    Component(custom_adj, "Custom Adjacent Servers", "ADJACENT_SERVER_CUSTOM_*", "Docker microservices via ENV", $tags="extension")
}

System_Boundary(testing_ci, "Testing & CI") {
    Component(playwright, "Playwright Tests", "tests/", "E2E + Unit tests", $tags="test")
    Component(ci_pipeline, "GitHub Actions", "CI/CD", "tests, secrets-detection,\ndocker-build, bump-version", $tags="test")
    Component(eslint_check, "ESLint", "Linting", "Must pass before merge", $tags="test")
}

System_Boundary(key_commands, "Key Commands") {
    Component(cmd_start, "npm start", "Dev Server", "init-db + server on PORT+1", $tags="cmd")
    Component(cmd_build, "npm run build", "Production", "Webpack 5 bundle", $tags="cmd")
    Component(cmd_test, "npm test", "All Tests", "Playwright E2E + unit", $tags="cmd")
    Component(cmd_start_test, "npm run start:test", "Test Server", "PORT=18888, DB=mmgis-test", $tags="cmd")
}

Rel_D(agent, agents_md, "Reads first")
Rel(agents_md, knowledge_dir, "References for details")
Rel(agents_md, specify_dir, "References for workflow")

Rel(agent, critical_rules, "Must follow")
Rel(agent, dev_workflow, "Follows for features")
Rel(agent, api_routes, "References for API")
Rel(agent, extensions, "Uses to extend")
Rel(agent, testing_ci, "Runs before submitting")

Rel(speckit, constitution, "Governed by")

@enduml
