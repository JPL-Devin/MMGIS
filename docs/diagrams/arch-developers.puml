@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title MMGIS - Developer Architecture View

top to bottom direction
LAYOUT_WITH_LEGEND()

skinparam {
    BackgroundColor white
    Shadowing true
    RoundCorner 15
    DefaultFontName "Segoe UI"
    DefaultFontSize 12
    ArrowColor #555555
    ArrowThickness 1.5
    wrapWidth 200
}

AddElementTag("highlight", $bgColor="#1565C0", $fontColor="white", $borderColor="#0D47A1")
AddElementTag("singleton", $bgColor="#0277BD", $fontColor="white", $borderColor="#01579B")
AddElementTag("backend", $bgColor="#2E7D32", $fontColor="white", $borderColor="#1B5E20")
AddElementTag("plugin", $bgColor="#6A1B9A", $fontColor="white", $borderColor="#4A148C")
AddElementTag("infra", $bgColor="#37474F", $fontColor="white", $borderColor="#263238")
AddElementTag("build", $bgColor="#E65100", $fontColor="white", $borderColor="#BF360C")
AddRelTag("dashed", $lineStyle=DashedLine())

Person(dev, "Developer", "Contributes to or extends MMGIS")

System_Boundary(mmgis, "MMGIS Application") {

    Container_Boundary(frontend, "Frontend (React + jQuery + Webpack 5)") {
        Component(essence, "essence.js", "Entry Point", "Bootstraps singletons, WebSocket, mission init", $tags="highlight")
        Component(ui, "UserInterface_", "Singleton", "Layout, panels, notifications, React UI shell", $tags="singleton")
        Component(layers, "Layers_ (L_)", "Singleton", "Layer state, registry, add/remove/update", $tags="singleton")
        Component(map, "Map_", "Singleton", "Leaflet 2D map controller", $tags="singleton")
        Component(globe, "Globe_", "Singleton", "Cesium / LithoSphere 3D globe", $tags="singleton")
        Component(viewer, "Viewer_", "Singleton", "OpenSeadragon, Photo, Model, PDF, Video", $tags="singleton")
        Component(toolctrl, "ToolController_", "Singleton", "Tool lifecycle: make() / destroy()", $tags="singleton")
        Component(formulae, "Formulae_ (F_)", "Singleton", "Math/geo utilities, coordinate transforms", $tags="singleton")
        Component(timecontrol, "TimeControl_", "Singleton", "Temporal filtering and animation", $tags="singleton")
        Component(tools, "16 Interactive Tools", "Plugins", "Draw, Measure, Legend, Identifier,\nLayers, Animation, Chemistry, Curtain,\nIsochrone, Info, Kinds, Query, Shade,\nSites, Viewshed, Segment")
        Component(mmgisapi, "mmgisAPI", "Client SDK", "Public JS API for embedding")
        Component(designsys, "Design System", "Theming", "Stylize, applyTheme, reusable components")
    }

    Container_Boundary(backend, "Backend (Express 5 / Node.js 22+)") {
        Component(server, "server.js", "Entry Point", "Express app, middleware, static serving", $tags="backend")
        Component(initdb, "init-db.js", "DB Bootstrap", "CREATE DATABASE, PostGIS extensions", $tags="backend")
        Component(middleware_comp, "Middleware Pipeline", "Express", "cssoHandler, ensureUser, ensureAdmin,\nhelmet, compression, rate-limit", $tags="backend")
        Component(config_api, "Config API", "/api/configure/*", "Mission CRUD", $tags="backend")
        Component(users_api, "Users API", "/api/users/*", "Auth & accounts", $tags="backend")
        Component(draw_api, "Draw API", "/api/draw/*", "Collaborative features", $tags="backend")
        Component(geodatasets_api, "Geodatasets API", "/api/geodatasets/*", "PostGIS queries", $tags="backend")
        Component(files_api, "Files API", "/api/files/*", "File serving", $tags="backend")
        Component(websocket_comp, "WebSocket Server", "ws", "Real-time updates & collaboration", $tags="backend")
        Component(sequelize_comp, "Sequelize ORM", "Models", "users, configs, geodatasets, tokens, sessions", $tags="backend")
        Component(setups_comp, "Setups Loader", "Dynamic", "Discovers backend modules + plugins", $tags="backend")
    }

    Container_Boundary(configure_app, "Configure App (Separate React Build)") {
        Component(configure, "Configure CMS", "React", "Mission management, layer editor, user admin", $tags="highlight")
    }

    Container_Boundary(plugins, "Plugin System (Auto-discovered)") {
        Component(tool_plugins, "Tool Plugins", "*Plugin-Tools*", "Custom tools in src/essence/", $tags="plugin")
        Component(backend_plugins, "Backend Plugins", "*Plugin-Backend*", "Custom API modules in API/", $tags="plugin")
        Component(component_plugins, "Component Plugins", "*Plugin-Components*", "Custom UI in src/essence/", $tags="plugin")
    }
}

Container_Boundary(adjacent, "Adjacent Microservices") {
    Component(titiler, "TiTiler :8883", "COG Renderer", "Dynamic Cloud-Optimized GeoTIFF", $tags="infra")
    Component(stac_fastapi, "STAC FastAPI :8881", "Catalog", "SpatioTemporal Asset Catalog", $tags="infra")
    Component(tipg, "TiPG :8882", "Vector Tiles", "PostGIS-backed OGC tiles", $tags="infra")
    Component(veloserver, "Veloserver :8104", "Velocity", "Wind/velocity visualization", $tags="infra")
}

ContainerDb(postgres, "PostgreSQL 16+ / PostGIS", "Database", "Missions, users, sessions, geodata, tokens")

Container_Boundary(build_tools, "Build & Test") {
    Component(webpack, "Webpack 5", "Bundler", "Main + Configure builds", $tags="build")
    Component(playwright_tests, "Playwright", "E2E + Unit", "tests/e2e/*, tests/unit/*", $tags="build")
    Component(ci, "GitHub Actions", "CI/CD", "Tests, Docker builds, secrets scan", $tags="build")
    Component(eslint, "ESLint", "Linter", "react-app config", $tags="build")
}

Rel_D(dev, essence, "Develops frontend")
Rel_D(dev, server, "Develops backend")

Rel(essence, layers, "Initializes")
Rel(essence, toolctrl, "Loads tools")
Rel(layers, map, "Layer data")
Rel(layers, globe, "Layer data")
Rel(toolctrl, tools, "Manages lifecycle")
Rel(ui, designsys, "Applies theming")
Rel(setups_comp, backend_plugins, "Discovers", $tags="dashed")

Rel(server, middleware_comp, "Applies chain")
Rel(server, setups_comp, "Loads modules")
Rel(sequelize_comp, postgres, "SQL / PostGIS")
Rel(server, websocket_comp, "Upgrades to WS")
Rel(essence, websocket_comp, "Real-time updates")

Rel(server, titiler, "Proxies /titiler/*", $tags="dashed")
Rel(server, stac_fastapi, "Proxies /stac/*", $tags="dashed")
Rel(stac_fastapi, postgres, "SQL")
Rel(ci, playwright_tests, "Runs")

@enduml
