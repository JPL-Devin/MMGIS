{
    "name": "PropertyBubbles",
    "type": "layerattachment",
    "attachmentId": "property_bubbles",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "configPath": "variables.layerAttachments.propertyBubbles",
    "description": "Proportional-symbol bubbles over the host's point features: radius scaled by a numeric property and color from a two-stop ramp across that property's range. Retunes live through mmgisAPI.setLayerAttachmentConfig instead of rebuilding its host.",
    "capabilities": {
        "renderers": {
            "map": {
                "engines": [
                    "leaflet"
                ]
            },
            "globe": false
        },
        "host": {
            "order": 7
        }
    },
    "applicableLayerTypes": [
        "vector",
        "query"
    ],
    "config": {
        "tab": "Attachment - Markers",
        "tabOrder": 12,
        "order": 10,
        "rows": [
            {
                "subname": "Property Bubbles",
                "components": [
                    {
                        "field": "variables.layerAttachments.propertyBubbles.enabled",
                        "name": "Enabled",
                        "description": "Scale a circle at each point feature by one of its numeric properties.",
                        "type": "switch",
                        "width": 3,
                        "defaultChecked": false
                    },
                    {
                        "field": "variables.layerAttachments.propertyBubbles.property",
                        "name": "Property",
                        "description": "The numeric feature property the bubbles are scaled and colored by.",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.propertyBubbles.minRadius",
                        "name": "Min Radius (px)",
                        "description": "Radius at the property's minimum. Default 4.",
                        "type": "number",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.propertyBubbles.maxRadius",
                        "name": "Max Radius (px)",
                        "description": "Radius at the property's maximum. Default 20.",
                        "type": "number",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.propertyBubbles.lowColor",
                        "name": "Low Color",
                        "description": "Color at the property's minimum.",
                        "type": "colorpicker",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.propertyBubbles.highColor",
                        "name": "High Color",
                        "description": "Color at the property's maximum.",
                        "type": "colorpicker",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.propertyBubbles.fillOpacity",
                        "name": "Fill Opacity",
                        "description": "0 to 1. Default 0.6.",
                        "type": "number",
                        "width": 3
                    }
                ]
            }
        ]
    },
    "module": "./propertyBubbles"
}
