{
    "name": "SubsurfaceInterfaces",
    "type": "layerattachment",
    "attachmentId": "subsurface_interfaces",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "configPath": "variables.layerAttachments.subsurfaceInterfaces",
    "description": "Markers at each radar-detected subsurface interface along a sounding track, coloured by depth.",
    "capabilities": {
        "renderers": {
            "map": {
                "engines": [
                    "leaflet"
                ]
            },
            "globe": false
        },
        "host": {
            "order": 60
        }
    },
    "applicableLayerTypes": [
        "radargram"
    ],
    "config": {
        "tab": "Attachment - Markers",
        "tabOrder": 100,
        "order": 0,
        "rows": [
            {
                "subname": "Subsurface Interfaces",
                "components": [
                    {
                        "field": "variables.layerAttachments.subsurfaceInterfaces.enabled",
                        "name": "Enabled",
                        "description": "",
                        "type": "switch",
                        "width": 3,
                        "defaultChecked": false
                    },
                    {
                        "field": "variables.layerAttachments.subsurfaceInterfaces.interfacesProp",
                        "name": "Interfaces property",
                        "description": "Feature property holding the array of detected interfaces.",
                        "type": "text",
                        "width": 3,
                        "default": "interfaces"
                    },
                    {
                        "field": "variables.layerAttachments.subsurfaceInterfaces.depthProp",
                        "name": "Depth key (m)",
                        "description": "Key inside each interface entry holding its depth in meters.",
                        "type": "text",
                        "width": 3,
                        "default": "depth_m"
                    },
                    {
                        "field": "variables.layerAttachments.subsurfaceInterfaces.maxDepthMeters",
                        "name": "Depth colour range (m)",
                        "description": "Depth the colour ramp saturates at. Match the layer type's radargram depth.",
                        "type": "number",
                        "width": 3,
                        "default": 3000
                    }
                ]
            }
        ]
    },
    "module": "./subsurfaceInterfaces"
}
