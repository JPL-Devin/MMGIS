{
    "name": "MagnitudeRings",
    "type": "layerattachment",
    "attachmentId": "magnitude_rings",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "configPath": "variables.layerAttachments.magnitudeRings",
    "description": "A ring per event, radius scaled by magnitude and colour banded by depth.",
    "capabilities": {
        "renderers": {
            "map": {
                "engines": ["leaflet"]
            },
            "globe": false
        },
        "host": {
            "order": 40
        }
    },
    "applicableLayerTypes": ["seismic", "vector", "query"],
    "config": {
        "tab": "Attachment - Markers",
        "tabOrder": 12,
        "order": 20,
        "rows": [
            {
                "subname": "Magnitude Rings",
                "components": [
                    {
                        "field": "variables.layerAttachments.magnitudeRings.enabled",
                        "name": "Enabled",
                        "description": "",
                        "type": "switch",
                        "width": 3,
                        "defaultChecked": false
                    },
                    {
                        "field": "variables.layerAttachments.magnitudeRings.scaleMeters",
                        "name": "Scale (m)",
                        "description": "Radius = scale * 2^magnitude.",
                        "type": "number",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.magnitudeRings.magnitudeProp",
                        "name": "Magnitude Property",
                        "description": "Feature property holding the magnitude. Defaults to `magnitude`.",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.magnitudeRings.depthProp",
                        "name": "Depth Property",
                        "description": "Feature property holding depth in km. Defaults to `depth_km`.",
                        "type": "text",
                        "width": 3
                    }
                ]
            }
        ]
    },
    "module": "./magnitudeRings"
}
