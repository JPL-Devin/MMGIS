{
    "name": "SampleTubes",
    "type": "layertype",
    "typeId": "sampletubes",
    "extends": "vector",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "color": "#4e9a06",
    "defaultIcon": "Layers",
    "description": "Sample tubes served by the SampleDepot backend plugin.",
    "pluginDependencies": [
        "sample-depot/backend/SampleDepot"
    ],
    "capabilities": {
        "renderers": {
            "map": {
                "engines": [
                    "leaflet"
                ]
            }
        },
        "defaultInteractions": {
            "click": [
                "tube:retrieve"
            ]
        }
    },
    "supportedData": [
        {
            "label": "MMGIS Sample Depot API",
            "category": "vector",
            "standards": [],
            "formats": [
                "GeoJSON"
            ],
            "extensions": [],
            "description": "Depots and tubes stored by this container's SampleDepot backend plugin. The layer needs no url."
        }
    ],
    "config": {
        "tabs": [
            {
                "name": "Core",
                "rows": [
                    {
                        "forceHeight": "64px",
                        "components": [
                            {
                                "field": "type",
                                "name": "Layer Type",
                                "description": "",
                                "type": "dropdown",
                                "width": 2,
                                "options": [
                                    "sampletubes"
                                ]
                            },
                            {
                                "field": "name",
                                "name": "Layer Name",
                                "description": "",
                                "type": "textnotrim",
                                "width": 8,
                                "required": true
                            },
                            {
                                "field": "visibility",
                                "name": "Initially On",
                                "description": "",
                                "type": "checkbox",
                                "width": 2,
                                "defaultChecked": false
                            }
                        ]
                    },
                    {
                        "name": "SampleTubes",
                        "components": [
                            {
                                "field": "variables.depot",
                                "name": "Depot Name",
                                "description": "Which depot's tubes this layer shows. Leave empty for all depots.",
                                "type": "text",
                                "width": 12
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "module": "./sampleTubes"
}
