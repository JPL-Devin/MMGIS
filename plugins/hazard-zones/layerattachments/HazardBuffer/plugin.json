{
    "name": "HazardBuffer",
    "type": "layerattachment",
    "attachmentId": "hazard_buffer",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "configPath": "variables.layerAttachments.hazardBuffer",
    "description": "An exclusion band drawn around every hazard zone, and the buffered geometry hazard:report tests a clicked feature against.",
    "author": "Hazard Zones plugin container",
    "license": "Apache-2.0",
    "capabilities": {
        "renderers": {
            "map": {
                "engines": ["leaflet"]
            },
            "globe": false
        },
        "host": {
            "order": 40
        }
    },
    "applicableLayerTypes": ["hazardzone"],
    "config": {
        "tab": "Attachment - Paths",
        "tabOrder": 100,
        "order": 0,
        "rows": [
            {
                "subname": "Hazard Exclusion Buffer",
                "components": [
                    {
                        "field": "variables.layerAttachments.hazardBuffer.enabled",
                        "name": "Enabled",
                        "description": "Draw an exclusion band around every zone.",
                        "type": "switch",
                        "width": 3,
                        "defaultChecked": false
                    },
                    {
                        "field": "variables.layerAttachments.hazardBuffer.bufferMeters",
                        "name": "Buffer (m)",
                        "description": "How far beyond each zone the exclusion band reaches.",
                        "type": "number",
                        "width": 3,
                        "default": 250,
                        "disableSwitch": "variables.layerAttachments.hazardBuffer.enabled"
                    },
                    {
                        "field": "variables.layerAttachments.hazardBuffer.color",
                        "name": "Band Colour",
                        "description": "Colour of the exclusion band.",
                        "type": "colorpicker",
                        "width": 3,
                        "disableSwitch": "variables.layerAttachments.hazardBuffer.enabled"
                    },
                    {
                        "field": "variables.layerAttachments.hazardBuffer.dashArray",
                        "name": "Dash",
                        "description": "SVG dash pattern of the band's outline.",
                        "type": "text",
                        "width": 3,
                        "default": "6 6",
                        "disableSwitch": "variables.layerAttachments.hazardBuffer.enabled"
                    }
                ]
            }
        ]
    },
    "module": "./hazardBuffer"
}
