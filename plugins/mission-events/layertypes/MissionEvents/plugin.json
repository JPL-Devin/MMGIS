{
    "name": "MissionEvents",
    "type": "layertype",
    "typeId": "missionevents",
    "extends": "vector",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "color": "#4e9a06",
    "defaultIcon": "Layers",
    "description": "Discrete mission events (drives, drills, anomalies) that each occupy a span of time.",
    "capabilities": {
        "renderers": {
            "map": {
                "engines": ["leaflet"]
            }
        },
        "time": {
            "histogram": true
        },
        "defaultAttachments": {
            "event_halo": {
                "durationProp": "durationSec",
                "maxRadiusMeters": 400
            }
        },
        "defaultInteractions": {
            "click": {
                "event:seek": { "padSec": 300 }
            }
        }
    },
    "supportedData": [
        {
            "label": "Mission event GeoJSON",
            "category": "vector",
            "standards": ["GeoJSON"],
            "formats": ["application/geo+json"],
            "extensions": [".json", ".geojson"],
            "description": "Point or line features with a start and end timestamp property."
        }
    ],
    "config": {
        "tabs": [
            {
                "name": "Core",
                "rows": [
                    {
                        "forceHeight": "64px",
                        "components": [
                            {
                                "field": "type",
                                "name": "Layer Type",
                                "description": "",
                                "type": "dropdown",
                                "width": 2,
                                "options": ["missionevents"]
                            },
                            {
                                "field": "name",
                                "name": "Layer Name",
                                "description": "",
                                "type": "textnotrim",
                                "width": 8,
                                "required": true
                            },
                            {
                                "field": "visibility",
                                "name": "Initially On",
                                "description": "",
                                "type": "checkbox",
                                "width": 2,
                                "defaultChecked": false
                            }
                        ]
                    },
                    {
                        "name": "Mission Events",
                        "components": [
                            {
                                "field": "url",
                                "name": "Events GeoJSON URL",
                                "description": "A FeatureCollection of events, each with a start and end timestamp property.",
                                "type": "text",
                                "width": 12
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "module": "./missionEvents"
}
