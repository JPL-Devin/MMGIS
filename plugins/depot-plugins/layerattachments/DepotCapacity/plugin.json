{
    "name": "DepotCapacity",
    "type": "layerattachment",
    "attachmentId": "depot_capacity",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "configPath": "variables.layerAttachments.depotCapacity",
    "description": "A capacity ring around each sample-tube depot: radius from the depot's capacity, colour and fill from how full it is.",
    "capabilities": {
        "renderers": {
            "map": {
                "engines": [
                    "leaflet"
                ]
            },
            "globe": false
        },
        "host": {
            "order": 40
        }
    },
    "applicableLayerTypes": [
        "sampledepot"
    ],
    "config": {
        "tab": "Attachment - Markers",
        "tabOrder": 12,
        "order": 9,
        "rows": [
            {
                "subname": "Depot Capacity",
                "components": [
                    {
                        "field": "variables.layerAttachments.depotCapacity.enabled",
                        "name": "Enabled",
                        "description": "Draw a capacity ring around each depot.",
                        "type": "switch",
                        "width": 3,
                        "defaultChecked": false
                    },
                    {
                        "field": "variables.layerAttachments.depotCapacity.capacityProp",
                        "name": "Capacity Property",
                        "description": "The feature property holding the depot's tube capacity.",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.depotCapacity.metersPerTube",
                        "name": "Meters per Tube",
                        "description": "Ring radius per unit of capacity.",
                        "type": "number",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.depotCapacity.minRadiusMeters",
                        "name": "Minimum Radius (m)",
                        "description": "Floor for the ring radius.",
                        "type": "number",
                        "width": 3
                    }
                ]
            }
        ]
    },
    "module": "./depotCapacity"
}
