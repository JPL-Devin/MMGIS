{
    "name": "SwathLook",
    "type": "layerattachment",
    "attachmentId": "swath_look",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "configPath": "variables.layerAttachments.swathLook",
    "description": "An arrow at each planned swath showing its roll/look direction.",
    "capabilities": {
        "renderers": {
            "map": {
                "engines": [
                    "leaflet"
                ]
            },
            "globe": false
        },
        "host": {
            "order": 100
        }
    },
    "applicableLayerTypes": [
        "swathcatalogue"
    ],
    "config": {
        "tab": "Attachment - Paths",
        "tabOrder": 14,
        "order": 9,
        "rows": [
            {
                "subname": "SwathLook",
                "components": [
                    {
                        "field": "variables.layerAttachments.swathLook.enabled",
                        "name": "Enabled",
                        "description": "",
                        "type": "switch",
                        "width": 3,
                        "defaultChecked": false
                    },
                    {
                        "field": "variables.layerAttachments.swathLook.azimuthProp",
                        "name": "Azimuth property",
                        "description": "Feature property holding the along-track azimuth in degrees.",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.swathLook.rollProp",
                        "name": "Roll property",
                        "description": "Feature property holding roll in degrees (sign gives the side).",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.swathLook.lengthDeg",
                        "name": "Arrow length (deg)",
                        "description": "",
                        "type": "number",
                        "width": 3
                    }
                ]
            }
        ]
    },
    "module": "./swathLook"
}
