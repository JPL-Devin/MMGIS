{
    "name": "WindBarbs",
    "type": "layerattachment",
    "attachmentId": "wind_barbs",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "configPath": "variables.layerAttachments.windBarbs",
    "description": "A wind barb at each point feature, pointing downwind and scaled by speed.",
    "capabilities": {
        "renderers": {
            "map": {
                "engines": [
                    "leaflet"
                ]
            },
            "globe": false
        },
        "host": {
            "order": 100
        }
    },
    "applicableLayerTypes": [
        "windfield",
        "vector",
        "query"
    ],
    "config": {
        "tab": "Attachment - Markers",
        "tabOrder": 100,
        "order": 0,
        "rows": [
            {
                "subname": "Wind Barbs",
                "components": [
                    {
                        "field": "variables.layerAttachments.windBarbs.enabled",
                        "name": "Enabled",
                        "description": "",
                        "type": "switch",
                        "width": 3,
                        "defaultChecked": false
                    },
                    {
                        "field": "variables.layerAttachments.windBarbs.speedProp",
                        "name": "Speed Property",
                        "description": "Leave empty on a windfield layer — the layer type supplies it.",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.windBarbs.directionProp",
                        "name": "Direction Property",
                        "description": "Leave empty on a windfield layer — the layer type supplies it.",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.windBarbs.scale",
                        "name": "Barb Scale",
                        "description": "Barb length per m/s, in units of 1e-5 degrees.",
                        "type": "number",
                        "width": 3
                    }
                ]
            }
        ]
    },
    "module": "./windBarbs"
}
