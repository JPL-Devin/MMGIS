                        "type": "number",
                        "width": 3
                    },
                    {
                        "field": "variables.layerAttachments.visibilityFootprint.color",
                        "name": "Color",
                        "description": "",
                        "type": "colorpicker",
                        "width": 3
                    }
                ]
            }
        ]
