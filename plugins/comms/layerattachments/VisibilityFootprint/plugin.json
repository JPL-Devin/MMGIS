        "order": 0,
        "rows": [
            {
                "subname": "Visibility Footprint",
                "components": [
                    {
                        "field": "variables.layerAttachments.visibilityFootprint.enabled",
                        "name": "Enabled",
                        "description": "",
                        "type": "switch",
                        "width": 3,
                        "defaultChecked": false
                    },
                    {
                        "field": "variables.layerAttachments.visibilityFootprint.elevationMaskDeg",
                        "name": "Elevation Mask (deg)",
