{
    "name": "VisibilityFootprint",
    "type": "layerattachment",
    "attachmentId": "visibility_footprint",
    "version": "1.0.0",
    "tier": "community",
    "overridable": true,
    "configPath": "variables.layerAttachments.visibilityFootprint",
    "description": "A circle around each surface asset sized from an elevation mask and the orbiter's altitude.",
    "capabilities": {
        "renderers": {
            "map": {
                "engines": [
                    "leaflet"
                ]
            },
            "globe": false
        },
        "host": {
            "order": 100
        }
    },
    "applicableLayerTypes": [
        "vector",
        "query"
    ],
    "config": {
        "tab": "Attachment - Markers",
